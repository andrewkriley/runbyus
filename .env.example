# Copy to .env and export. Never commit values.

RUNBYUS_RUNTIME=pydanticai
RUNBYUS_LIVE=0

# One local OpenAI-spec listener
RUNBYUS_LOCAL_TARGET=local
RUNBYUS_LOCAL_BASE_URL=http://127.0.0.1:8000/v1
RUNBYUS_LOCAL_MODEL=local-model
RUNBYUS_LOCAL_API_KEY=

# Cloud diagnose
RUNBYUS_CLOUD=anthropic
RUNBYUS_ANTHROPIC_API_KEY=
RUNBYUS_ANTHROPIC_MODEL=
RUNBYUS_ANTHROPIC_BASE_URL=https://api.anthropic.com
RUNBYUS_OPENAI_API_KEY=
RUNBYUS_OPENAI_MODEL=gpt-4o
RUNBYUS_OPENAI_BASE_URL=https://api.openai.com/v1
